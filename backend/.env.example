# Django secret key -- generate a real one for anything beyond local dev:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-before-deploying

# True for local development only. Must be False in production.
DEBUG=True

# Comma-separated list of hostnames this API is allowed to serve.
# Required (and enforced) once DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres connection string, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# If comitted, falls back to a local sqlite3 file so the project still runs
# out of the box.
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Only relevant when DEBUG=False. Set to False if you're behind a proxy/load
# balancer that already terminates SSL and you don't want Django redirecting.
SECURE_SSL_REDIRECT=True

LOG_LEVEL=INFO
